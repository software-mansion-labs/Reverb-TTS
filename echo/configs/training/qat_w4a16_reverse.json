{
    "meta": {
        "version": 1,
        "name": "echo-rl-round5-qat-w4a16-reverse",
        "seed": 4321,
        "notes": "W4A16 quantization-aware training of the RL round-5 winner (runs/rl/round_5), learning the distribution of its frozen full-precision self on the traced main-path states of s8, s8 + rmc025 and s6 + rmc025 (masking.samplers) plus the polish state. Reverse KL only, KL(student || teacher): mode-seeking, against the forward-KL run's critic loss (-0.2) and main-path CE drift (dCE -1.5) - otherwise the qat_w4a16.json recipe. Symmetric int4 weights, one scale per group of 32 inputs, in the decoder linears. 5 epochs, LR 1e-5 with a cosine decay to 1e-6. PTQ KL 0.580 dev / 0.501 test (s8, 20 batches); the 2026-11-07 probes (1 GPU, 1,200 steps): 1e-5 and 3e-5 tied at 0.20 dev, 1e-5 led at step 600 and drifted less in CE (main dCE -1.4 vs -1.9), 5e-6 0.24, 1e-6 0.32. A checkpoint every 2,000 steps is kept, for generation checks along the run. Run with --bits 4 --group-size 32 --no-activations."
    },

    "models": {
        "student": "echo/configs/model/rl_round5.json",
        "teacher": "echo/configs/model/rl_round5.json"
    },

    "data": {
        "train_manifest": "data/train/train_processed.csv",
        "dev_manifest": "data/dev/dev_processed.csv",
        "test_manifest": "data/test/test_in_processed.csv",
        "data_root": null,
        "max_batch_size": 128,
        "max_batch_tokens": 16384,
        "max_pad_ratio": 0.3,
        "packing": "sorted",
        "packing_chunk": 2048,
        "num_workers": 12,
        "seed": 4321
    },

    "preprocessing": {
        "tokenizer": "runs/rl/round_5",
        "drop_prefix_ratio": 0.0,
        "prefix_split": {
            "prefix_min_dur": 1.5,
            "prefix_min_ratio": 0.0,
            "prefix_max_ratio": 0.5
        }
    },

    "masking": {
        "polish_share": 0.25,
        "polish_weights": [8.0, 8.0, 4.0, 4.0, 2.0, 2.0],
        "stage_shares": null,
        "samplers": {"s8": 1.0, "s8_rmc025": 1.0, "s6_rmc025": 1.0},
        "min_pass_share": 0.01
    },

    "loss": {
        "main": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "polish": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "temperature": 1.0,
        "reverse_kl": true
    },

    "optim": {
        "learning_rate": 1e-05,
        "weight_decay": 0.01,
        "max_grad_norm": 1.0,
        "gradient_accumulation_steps": 1,
        "mixed_precision": "bf16",
        "gradient_checkpointing": true
    },

    "schedule": {
        "steps": null,
        "epochs": 5,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.03,
        "min_lr_ratio": 0.1
    },

    "logging": {
        "log_every_steps": 100
    },

    "evaluation": {
        "eval_every_steps": 2000,
        "eval_batches": 50,
        "eval_on_dev": true,
        "eval_on_test": true,
        "prefix_ratio": 0.25
    },

    "checkpoint": {
        "output_dir": "runs/rl/round_5_qat/w4a16_reverse",
        "resume": null,
        "save_every_steps": 2000,
        "save_at_epoch_end": false,
        "keep_last_n_checkpoints": 0
    },

    "tracking": {
        "enabled": false
    }
}
