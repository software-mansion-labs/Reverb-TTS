{
    "meta": {
        "version": 1,
        "name": "echo-rl-round5-qat-w4a8",
        "seed": 4321,
        "notes": "W4A8 quantization-aware training of the RL round-5 winner (runs/rl/round_5), learning the distribution of its frozen full-precision self on the traced main-path states of s8, s8 + rmc025 and s6 + rmc025 (masking.samplers) plus the polish state. Forward KL only. Symmetric int4 weights, one scale per group of 32 inputs, and int8 inputs per token in the decoder linears. 1 epoch at 5e-6 (between W4A16's 1e-5 and the int8 activations' instability at 5e-6 on p3 - probe the rate first), cosine decay to 1e-6. Run with --bits 4 --group-size 32 --activations."
    },

    "models": {
        "student": "echo/configs/model/rl_round5.json",
        "teacher": "echo/configs/model/rl_round5.json"
    },

    "data": {
        "train_manifest": "data/train/train_processed.csv",
        "dev_manifest": "data/dev/dev_processed.csv",
        "test_manifest": "data/test/test_in_processed.csv",
        "data_root": null,
        "max_batch_size": 128,
        "max_batch_tokens": 16384,
        "max_pad_ratio": 0.3,
        "packing": "sorted",
        "packing_chunk": 2048,
        "num_workers": 16,
        "seed": 4321
    },

    "preprocessing": {
        "tokenizer": "runs/rl/round_5",
        "drop_prefix_ratio": 0.0,
        "prefix_split": {
            "prefix_min_dur": 1.5,
            "prefix_min_ratio": 0.0,
            "prefix_max_ratio": 0.5
        }
    },

    "masking": {
        "polish_share": 0.25,
        "polish_weights": [8.0, 8.0, 4.0, 4.0, 2.0, 2.0],
        "stage_shares": null,
        "samplers": {"s8": 1.0, "s8_rmc025": 1.0, "s6_rmc025": 1.0},
        "min_pass_share": 0.01
    },

    "loss": {
        "main": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "polish": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "temperature": 1.0,
        "reverse_kl": false
    },

    "optim": {
        "learning_rate": 5e-06,
        "weight_decay": 0.01,
        "max_grad_norm": 1.0,
        "gradient_accumulation_steps": 1,
        "mixed_precision": "bf16",
        "gradient_checkpointing": true
    },

    "schedule": {
        "steps": null,
        "epochs": 1,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.03,
        "min_lr_ratio": 0.2
    },

    "logging": {
        "log_every_steps": 100
    },

    "evaluation": {
        "eval_every_steps": 2000,
        "eval_batches": 50,
        "eval_on_dev": true,
        "eval_on_test": true,
        "prefix_ratio": 0.25
    },

    "checkpoint": {
        "output_dir": "runs/rl/round_5_qat/w4a8",
        "resume": null,
        "save_every_steps": 1000,
        "save_at_epoch_end": false,
        "keep_last_n_checkpoints": 3
    },

    "tracking": {
        "enabled": false
    }
}
