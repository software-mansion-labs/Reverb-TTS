{
    "meta": {
        "version": 1,
        "name": "echo-rl-round5-qat-w8a8",
        "seed": 4321,
        "notes": "W8A8 quantization-aware training of the RL round-5 winner (runs/rl/round_5), learning the distribution of its frozen full-precision self on the traced main-path states of s8, s8 + rmc025 and s6 + rmc025 (masking.samplers) plus the polish state. Forward KL only. int8 weights per output channel and int8 inputs per token in the decoder linears. Starts from SmoothQuant alpha 0.65 folded into the fp32 weights (runs/rl/round_5_quant/w8a8_smooth065_fp32, exact in fp32; pass it as --init): PTQ KL 0.037 dev / 0.031 test, plain W8A8 0.054 / 0.049. 1 epoch at 5e-7, cosine decay to 5e-8: the 2026-11-07 probes (1 GPU, 1,000 steps) improved only at 5e-7 and 1e-6 (dev 0.037 -> 0.032 at step 600), 3e-6 and 5e-6 diverged. Run with --bits 8 --activations."
    },

    "models": {
        "student": "echo/configs/model/rl_round5.json",
        "teacher": "echo/configs/model/rl_round5.json"
    },

    "data": {
        "train_manifest": "data/train/train_processed.csv",
        "dev_manifest": "data/dev/dev_processed.csv",
        "test_manifest": "data/test/test_in_processed.csv",
        "data_root": null,
        "max_batch_size": 128,
        "max_batch_tokens": 16384,
        "max_pad_ratio": 0.3,
        "packing": "sorted",
        "packing_chunk": 2048,
        "num_workers": 12,
        "seed": 4321
    },

    "preprocessing": {
        "tokenizer": "runs/rl/round_5",
        "drop_prefix_ratio": 0.0,
        "prefix_split": {
            "prefix_min_dur": 1.5,
            "prefix_min_ratio": 0.0,
            "prefix_max_ratio": 0.5
        }
    },

    "masking": {
        "polish_share": 0.25,
        "polish_weights": [8.0, 8.0, 4.0, 4.0, 2.0, 2.0],
        "stage_shares": null,
        "samplers": {"s8": 1.0, "s8_rmc025": 1.0, "s6_rmc025": 1.0},
        "min_pass_share": 0.01
    },

    "loss": {
        "main": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "polish": {"ce": 0.0, "kl": 1.0, "ce_selection": 1.0},
        "temperature": 1.0,
        "reverse_kl": false
    },

    "optim": {
        "learning_rate": 5e-07,
        "weight_decay": 0.01,
        "max_grad_norm": 1.0,
        "gradient_accumulation_steps": 1,
        "mixed_precision": "bf16",
        "gradient_checkpointing": true
    },

    "schedule": {
        "steps": null,
        "epochs": 1,
        "lr_scheduler_type": "cosine",
        "warmup_ratio": 0.03,
        "min_lr_ratio": 0.1
    },

    "logging": {
        "log_every_steps": 100
    },

    "evaluation": {
        "eval_every_steps": 2000,
        "eval_batches": 50,
        "eval_on_dev": true,
        "eval_on_test": true,
        "prefix_ratio": 0.25
    },

    "checkpoint": {
        "output_dir": "runs/rl/round_5_qat/w8a8",
        "resume": null,
        "save_every_steps": 1000,
        "save_at_epoch_end": false,
        "keep_last_n_checkpoints": 3
    },

    "tracking": {
        "enabled": false
    }
}
